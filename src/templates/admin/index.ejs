<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Admin Dashboard</title>
    <style>label{display:block;margin:6px 0}</style>
  </head>
  <body>
    <h1>Admin Dashboard</h1>

    <section>
      <h2>Create User</h2>
      <form method="post" action="/admin/users">
        <label>Email: <input name="email" type="email" required/></label>
        <label>Display name: <input name="displayName"/></label>
        <label>Password: <input name="password" type="password" required/></label>
        <button>Create</button>
      </form>
    </section>

    <section>
      <h2>Create Service</h2>
      <form method="post" action="/admin/services">
        <label>Url: <input name="name" required/></label>
        <label>Description: <input name="description"/></label>
        <button>Create Service</button>
      </form>
    </section>

    <section>
      <h2>Service Attributes</h2>
      <% services.forEach(function(s){ %>
        <div style="margin:12px 0;padding:8px;border:1px solid #ccc;">
          <h4><%= s.name %> (#<%= s.id %>)</h4>
          <p>Attributes: <%= (s.attributes || []).map(function(a){return a.name + ' (' + (a.type || 'string') + ')'}).join(', ') || 'None' %></p>
          <% (s.attributes || []).forEach(function(attr){ %>
            <form method="post" action="/admin/service-attributes/update" style="margin:8px 0;padding:8px;background:#f7f7f7;">
              <input type="hidden" name="serviceId" value="<%= s.id %>" />
              <input type="hidden" name="oldAttributeName" value="<%= attr.name %>" />
              <label>Attribute name: <input name="attributeName" value="<%= attr.name %>" required/></label>
              <label>Type:
                <select name="attributeType" required>
                  <option value="string" <%= (attr.type || 'string') === 'string' ? 'selected' : '' %>>string</option>
                  <option value="email" <%= attr.type === 'email' ? 'selected' : '' %>>email</option>
                  <option value="number" <%= attr.type === 'number' ? 'selected' : '' %>>number</option>
                  <option value="boolean" <%= attr.type === 'boolean' ? 'selected' : '' %>>boolean</option>
                  <option value="array" <%= attr.type === 'array' ? 'selected' : '' %>>array</option>
                </select>
              </label>
              <button type="submit">Save Attribute</button>
            </form>
            <form method="post" action="/admin/service-attributes/remove" style="margin-top:-4px;margin-bottom:10px;">
              <input type="hidden" name="serviceId" value="<%= s.id %>" />
              <input type="hidden" name="attributeName" value="<%= attr.name %>" />
              <button type="submit" style="background:#b00020;color:#fff;">Remove Attribute</button>
            </form>
          <% }) %>
          <form method="post" action="/admin/service-attributes" style="margin-top:6px;">
            <input type="hidden" name="serviceId" value="<%= s.id %>" />
            <label>Attribute name: <input name="attributeName" required/></label>
            <label>Type:
              <select name="attributeType" required>
                <option value="string">string</option>
                <option value="email">email</option>
                <option value="number">number</option>
                <option value="boolean">boolean</option>
                <option value="array">array</option>
              </select>
            </label>
            <button type="submit">Add Attribute</button>
          </form>
        </div>
      <% }) %>
    </section>

    <section>
      <h2>Assign Service to User</h2>
      <form method="post" action="/admin/assign">
        <label>User:
          <select name="userId">
            <% users.forEach(function(u){ %>
              <option value="<%= u.id %>"><%= u.displayName || u.email %> (#<%= u.id %>)</option>
            <% }) %>
          </select>
        </label>
        <label>Service:
          <select name="serviceId">
            <% services.forEach(function(s){ %>
              <option value="<%= s.id %>"><%= s.name %> (#<%= s.id %>)</option>
            <% }) %>
          </select>
        </label>
        <button>Assign</button>
      </form>
    </section>

    <section>
      <h2>Existing Users</h2>
      <ul>
        <% users.forEach(function(u){ %>
          <li>
            <strong><%= u.displayName || u.email %></strong> (#<%= u.id %>)
            <br/>Assigned services:
            <ul>
              <% (assignments[String(u.id)]||[]).forEach(function(sid){ %>
                <% var s = services.find(function(x){return x.id===sid}); %>
                <li>
                  <%= s ? s.name : 'Unknown (#'+sid+')' %>
                  <form method="post" action="/admin/unassign" style="display:inline;">
                    <input type="hidden" name="userId" value="<%= u.id %>" />
                    <input type="hidden" name="serviceId" value="<%= sid %>" />
                    <button type="submit" style="font-size:0.8em;padding:2px 6px;">Unassign</button>
                  </form>
                  <% if (s && s.attributes && s.attributes.length > 0) { %>
                    <div style="margin-left:20px;margin-top:6px;padding:6px;background:#f0f0f0;">
                      <strong>Attributes:</strong>
                      <% s.attributes.forEach(function(attr){ %>
                        <% var attrKey = u.id + '-' + sid; %>
                        <% var attrValue = userAttributesByServiceAndUser[attrKey] && userAttributesByServiceAndUser[attrKey][attr.name] ? userAttributesByServiceAndUser[attrKey][attr.name] : ''; %>
                        <% var attrValues = attr.type === 'array' ? attrValue.split(/[\n,]/).map(function(value){ return value.trim(); }).filter(Boolean) : [attrValue]; %>
                        <div style="margin:6px 0;">
                          <label><%= attr.name %>:</label>
                          <% if (attr.type === 'array') { %>
                            <div id="attr_group_<%= u.id %>_<%= sid %>_<%= attr.name %>" data-array-attribute="true" style="margin:4px 0;display:grid;gap:6px;max-width:320px;">
                              <% if (attrValues.length > 0) { %>
                                <% attrValues.forEach(function(value, index){ %>
                                  <div style="display:flex;gap:6px;align-items:center;">
                                    <input type="text" class="array-attribute-input" data-array-attribute-input="true" style="flex:1;min-width:0;" value="<%= value %>" placeholder="Value <%= index + 1 %>" />
                                    <button type="button" onclick="removeAttributeValue(this)">Remove</button>
                                  </div>
                                <% }) %>
                              <% } else { %>
                                <div style="display:flex;gap:6px;align-items:center;">
                                  <input type="text" class="array-attribute-input" data-array-attribute-input="true" style="flex:1;min-width:0;" value="" placeholder="Value 1" />
                                  <button type="button" onclick="removeAttributeValue(this)">Remove</button>
                                </div>
                              <% } %>
                            </div>
                            <div style="font-size:0.85em;color:#666;">Add one input per value.</div>
                            <button type="button" data-user-id="<%= u.id %>" data-service-id="<%= sid %>" data-attr-name="<%= attr.name %>" onclick="addAttributeValue(this)">Add value</button>
                          <% } else { %>
                            <input type="text" id="attr_<%= u.id %>_<%= sid %>_<%= attr.name %>" style="width:150px;" value="<%= attrValue %>" />
                          <% } %>
                          <button type="button" data-user-id="<%= u.id %>" data-service-id="<%= sid %>" data-attr-name="<%= attr.name %>" onclick="setUserAttribute(this)">Set</button>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
    </section>

    <script>
      function addAttributeValue(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);

        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.gap = '6px';
        row.style.alignItems = 'center';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'array-attribute-input';
        input.setAttribute('data-array-attribute-input', 'true');
        input.style.flex = '1';
        input.style.minWidth = '0';
        row.appendChild(input);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.textContent = 'Remove';
        removeButton.onclick = function () {
          row.remove();
        };
        row.appendChild(removeButton);

        group.appendChild(row);
      }

      function removeAttributeValue(button) {
        const row = button.closest('div');
        if (row) {
          row.remove();
        }
      }

      function setUserAttribute(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);
        const directInputId = 'attr_' + userId + '_' + serviceId + '_' + attributeName;
        const directInput = document.getElementById(directInputId);

        const attributeValues = group
          ? Array.from(group.querySelectorAll('[data-array-attribute-input="true"]'))
              .map(function (input) { return input.value.trim(); })
              .filter(Boolean)
          : [directInput ? directInput.value : ''];
        
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/admin/user-attributes';
        
        const inputs = [
          { name: 'userId', value: userId },
          { name: 'serviceId', value: serviceId },
          { name: 'attributeName', value: attributeName },
        ];

        if (group) {
          attributeValues.forEach(function (value) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = value;
            form.appendChild(field);
          });
          if (!attributeValues.length) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = '';
            form.appendChild(field);
          }
        } else {
          inputs.push({ name: 'attributeValue', value: attributeValues[0] });
        }
        
        inputs.forEach(function(input) {
          const field = document.createElement('input');
          field.type = 'hidden';
          field.name = input.name;
          field.value = input.value;
          form.appendChild(field);
        });
        
        document.body.appendChild(form);
        form.submit();
      }
    </script>
  </body>
</html>
