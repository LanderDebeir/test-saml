<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f3efe8;
        --bg-2: #e5ecef;
        --surface: rgba(255, 255, 255, 0.82);
        --text: #1f2937;
        --muted: #667085;
        --accent: #0f766e;
        --danger: #b42318;
        --border: rgba(15, 23, 42, 0.08);
        --shadow: 0 24px 70px rgba(15, 23, 42, 0.14);
        --shadow-soft: 0 10px 24px rgba(15, 23, 42, 0.08);
        --radius-xl: 28px;
        --radius-lg: 20px;
      }

      * { box-sizing: border-box; }

      html { min-height: 100%; }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: "Trebuchet MS", "Lucida Grande", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(124, 58, 237, 0.14), transparent 28%),
          radial-gradient(circle at top right, rgba(15, 118, 110, 0.14), transparent 24%),
          linear-gradient(135deg, var(--bg) 0%, var(--bg-2) 100%);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(rgba(255, 255, 255, 0.2) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.2) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.16), transparent 80%);
      }

      .page {
        position: relative;
        max-width: 1440px;
        margin: 0 auto;
        padding: 28px;
      }

      .hero {
        display: grid;
        gap: 18px;
        padding: 28px;
        margin-bottom: 24px;
        border: 1px solid var(--border);
        border-radius: 32px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.7));
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.09);
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero h1 {
        margin: 0;
        font-family: "Georgia", "Times New Roman", serif;
        font-size: clamp(2.3rem, 4vw, 4.2rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
      }

      .hero-copy {
        max-width: 780px;
        margin: 0;
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-soft);
        font-size: 0.92rem;
      }

      .chip strong { font-weight: 700; }

      .layout {
        display: grid;
        gap: 22px;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      }

      .stack {
        display: grid;
        gap: 22px;
      }

      .panel {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        background: var(--surface);
        backdrop-filter: blur(16px);
        box-shadow: var(--shadow-soft);
      }

      .panel h2 {
        margin: 0 0 8px;
        font-family: "Georgia", "Times New Roman", serif;
        font-size: 1.45rem;
        letter-spacing: -0.02em;
      }

      .panel-intro {
        margin: 0 0 18px;
        color: var(--muted);
        line-height: 1.55;
      }

      .form-grid { display: grid; gap: 14px; }

      .field { display: grid; gap: 8px; }

      .field label,
      .inline-label {
        font-size: 0.92rem;
        font-weight: 700;
        color: #334155;
      }

      .field input,
      .field select,
      .field textarea,
      .user-attribute-input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid rgba(100, 116, 139, 0.22);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.95);
        color: var(--text);
        font: inherit;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
      }

      .field input:focus,
      .field select:focus,
      .field textarea:focus,
      .user-attribute-input:focus {
        outline: none;
        border-color: rgba(15, 118, 110, 0.55);
        box-shadow: 0 0 0 4px rgba(15, 118, 110, 0.12);
      }

      .field textarea {
        resize: vertical;
        min-height: 96px;
      }

      .button-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 4px;
      }

      button {
        appearance: none;
        border: none;
        border-radius: 999px;
        padding: 11px 16px;
        background: linear-gradient(135deg, var(--accent), #0b534d);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 12px 24px rgba(15, 118, 110, 0.22);
        transition: transform 120ms ease, box-shadow 120ms ease, opacity 120ms ease;
      }

      button:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 28px rgba(15, 118, 110, 0.24);
      }

      button:active {
        transform: translateY(0);
        opacity: 0.96;
      }

      button.secondary {
        background: linear-gradient(135deg, #475569, #334155);
        box-shadow: 0 12px 24px rgba(51, 65, 85, 0.18);
      }

      button.danger {
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        box-shadow: 0 12px 24px rgba(185, 28, 28, 0.18);
      }

      .services-list,
      .user-list {
        display: grid;
        gap: 16px;
      }

      .service-card,
      .user-card {
        padding: 18px;
        border-radius: var(--radius-lg);
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(248, 250, 252, 0.92));
      }

      .service-head,
      .user-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
      }

      .service-head h3,
      .user-head h3 {
        margin: 0;
        font-size: 1.08rem;
      }

      .meta-line {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.09);
        color: #0f766e;
        font-size: 0.82rem;
        font-weight: 700;
      }

      .tag.neutral {
        background: rgba(100, 116, 139, 0.08);
        color: #475569;
      }

      .attribute-editor {
        display: grid;
        gap: 12px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(148, 163, 184, 0.18);
      }

      .attribute-editor + .attribute-editor {
        margin-top: 12px;
      }

      .attribute-row {
        display: grid;
        gap: 8px;
        padding: 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(148, 163, 184, 0.14);
      }

      .attribute-row-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .attribute-row-head strong {
        font-size: 0.96rem;
      }

      .attribute-values { display: grid; gap: 8px; }

      .array-group { display: grid; gap: 8px; }

      .array-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .array-row input,
      .single-input-row input {
        flex: 1;
        min-width: 0;
      }

      .help-text {
        margin: 0;
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.5;
      }

      .assignment-list {
        display: grid;
        gap: 12px;
        margin: 10px 0 0;
        padding: 0;
        list-style: none;
      }

      .assignment-item {
        padding: 14px;
        border-radius: 16px;
        border: 1px solid rgba(148, 163, 184, 0.16);
        background: rgba(255, 255, 255, 0.7);
      }

      .assignment-title {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
      }

      .assignment-title strong {
        font-size: 0.98rem;
      }

      .compact-action button {
        padding: 9px 13px;
        font-size: 0.88rem;
      }

      .empty-state {
        margin: 0;
        padding: 18px;
        border-radius: 18px;
        border: 1px dashed rgba(148, 163, 184, 0.35);
        color: var(--muted);
        background: rgba(255, 255, 255, 0.6);
      }

      .user-workbench {
        display: grid;
        gap: 16px;
      }

      .user-selector-bar {
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(260px, 360px) 1fr;
        align-items: end;
        padding: 16px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.68);
        border: 1px solid rgba(148, 163, 184, 0.16);
      }

      .overview-shell {
        display: grid;
        gap: 16px;
      }

      .user-overview {
        display: grid;
        gap: 16px;
      }

      .user-overview[hidden] {
        display: none !important;
      }

      .overview-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(124, 58, 237, 0.08));
        border: 1px solid rgba(148, 163, 184, 0.16);
      }

      .overview-summary h3 {
        margin: 0;
        font-size: 1.1rem;
      }

      .overview-summary .help-text {
        margin-top: 6px;
      }

      .service-card.assigned {
        border-color: rgba(15, 118, 110, 0.28);
        box-shadow: 0 14px 28px rgba(15, 118, 110, 0.08);
      }

      .service-card.unassigned {
        opacity: 0.92;
      }

      .service-card + .service-card {
        margin-top: 0;
      }

      .service-head-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
      }

      .status-pill.assigned {
        background: rgba(15, 118, 110, 0.12);
        color: #0f766e;
      }

      .status-pill.unassigned {
        background: rgba(100, 116, 139, 0.12);
        color: #475569;
      }

      .service-body {
        display: grid;
        gap: 12px;
      }

      .service-note {
        margin: 0;
        color: var(--muted);
        line-height: 1.55;
      }

      .service-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .service-workbench {
        display: grid;
        gap: 16px;
      }

      .service-selector-bar {
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(260px, 360px) 1fr;
        align-items: end;
        padding: 16px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.68);
        border: 1px solid rgba(148, 163, 184, 0.16);
      }

      .service-overview {
        display: grid;
        gap: 16px;
      }

      .service-overview[hidden] {
        display: none !important;
      }

      .service-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(15, 118, 110, 0.08), rgba(124, 58, 237, 0.08));
        border: 1px solid rgba(148, 163, 184, 0.16);
      }

      .service-summary h3 {
        margin: 0;
        font-size: 1.1rem;
      }

      .service-summary .help-text {
        margin-top: 6px;
      }

      .service-list-grid {
        display: grid;
        gap: 14px;
      }

      .service-attribute-shell {
        display: grid;
        gap: 12px;
      }

      @media (max-width: 1080px) {
        .layout { grid-template-columns: 1fr; }
      }

      @media (max-width: 720px) {
        .page { padding: 16px; }

        .hero,
        .panel {
          padding: 18px;
          border-radius: 22px;
        }

        .service-head,
        .user-head,
        .assignment-title,
        .attribute-row-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .array-row {
          flex-direction: column;
          align-items: stretch;
        }

        .array-row button,
        .compact-action button { width: 100%; }

        .user-selector-bar {
          grid-template-columns: 1fr;
        }

        .service-selector-bar {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <% const serviceCount = services.length; %>
    <% const userCount = users.length; %>
    <% const assignmentCount = Object.values(assignments).reduce(function(total, ids){ return total + ids.length; }, 0); %>
    <% const selectedUserId = users.length ? String(users[0].id) : ''; %>
    <% const selectedServiceId = services.length ? String(services[0].id) : ''; %>

    <div class="page">
      <header class="hero">
        <span class="eyebrow">Admin console</span>
        <h1>Control identity with a calmer, sharper dashboard.</h1>
        <p class="hero-copy">
          Create users, manage service metadata, and assign claims from a layout that feels
          closer to a control room than a form dump.
        </p>
        <div class="hero-meta">
          <span class="chip"><strong><%= userCount %></strong> users</span>
          <span class="chip"><strong><%= serviceCount %></strong> services</span>
          <span class="chip"><strong><%= assignmentCount %></strong> assignments</span>
        </div>
      </header>

      <div class="layout">
        <div class="stack">
          <section class="panel">
            <h2>Create User</h2>
            <p class="panel-intro">Spin up a new account for direct login or SAML-linked access.</p>
            <form method="post" action="/admin/users" class="form-grid">
              <div class="field">
                <label for="user-email">Email</label>
                <input id="user-email" name="email" type="email" required />
              </div>
              <div class="field">
                <label for="user-display-name">Display name</label>
                <input id="user-display-name" name="displayName" />
              </div>
              <div class="field">
                <label for="user-password">Password</label>
                <input id="user-password" name="password" type="password" required />
              </div>
              <div class="button-row">
                <button type="submit">Create user</button>
              </div>
            </form>
          </section>

          <section class="panel">
            <h2>Create Service</h2>
            <p class="panel-intro">Register a service provider entry and describe the target audience.</p>
            <form method="post" action="/admin/services" class="form-grid">
              <div class="field">
                <label for="service-name">Service URL or name</label>
                <input id="service-name" name="name" required />
              </div>
              <div class="field">
                <label for="service-description">Description</label>
                <textarea id="service-description" name="description" placeholder="Optional context for this service"></textarea>
              </div>
              <div class="button-row">
                <button type="submit">Create service</button>
              </div>
            </form>
          </section>

          <section class="panel">
            <h2>Assign Service to User</h2>
            <p class="panel-intro">Connect a user to a service so SAML assertions can flow cleanly.</p>
            <form method="post" action="/admin/assign" class="form-grid">
              <div class="field">
                <label for="assign-user">User</label>
                <select id="assign-user" name="userId">
                  <% users.forEach(function(u){ %>
                    <option value="<%= u.id %>"><%= u.displayName || u.email %> (#<%= u.id %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="field">
                <label for="assign-service">Service</label>
                <select id="assign-service" name="serviceId">
                  <% services.forEach(function(s){ %>
                    <option value="<%= s.id %>"><%= s.name %> (#<%= s.id %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="button-row">
                <button type="submit">Assign</button>
              </div>
            </form>
          </section>
        </div>

        <div class="stack">
          <section class="panel">
            <h2>Service Attributes</h2>
            <p class="panel-intro">Choose a service, then edit its attributes and definition without scanning the whole list.</p>
            <% if (services.length === 0) { %>
              <p class="empty-state">No services are configured yet.</p>
            <% } else { %>
              <div class="service-workbench">
                <div class="service-selector-bar">
                  <div class="field">
                    <label for="selected-service">Select service</label>
                    <select id="selected-service" name="selectedServiceId">
                      <% services.forEach(function(s){ %>
                        <option value="<%= s.id %>" <%= String(s.id) === selectedServiceId ? 'selected' : '' %>><%= s.name %> (#<%= s.id %>)</option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="tag-list" id="selected-service-meta">
                    <span class="tag neutral" id="selected-service-attribute-count"><%= (services[0].attributes || []).length %> attributes</span>
                    <span class="tag neutral" id="selected-service-name"><%= services[0].name %></span>
                  </div>
                </div>

                <div class="service-list-grid">
                  <% services.forEach(function(s){ %>
                    <article class="service-overview" data-service-overview="<%= s.id %>" data-attribute-count="<%= (s.attributes || []).length %>" <%= String(s.id) === selectedServiceId ? '' : 'hidden' %>>
                      <div class="service-summary">
                        <div>
                          <h3><%= s.name %></h3>
                          <p class="help-text">Service #<%= s.id %></p>
                        </div>
                        <div class="tag-list">
                          <span class="tag"><%= (s.attributes || []).length %> attributes</span>
                        </div>
                      </div>

                      <div class="service-card assigned">
                        <div class="service-body">
                          <p class="service-note">
                            <%= (s.attributes && s.attributes.length > 0) ? ('This service exposes ' + s.attributes.length + ' editable attributes.') : 'No service attributes have been defined yet.' %>
                          </p>

                          <% (s.attributes || []).forEach(function(attr){ %>
                            <form method="post" action="/admin/service-attributes/update" class="attribute-editor">
                              <input type="hidden" name="serviceId" value="<%= s.id %>" />
                              <input type="hidden" name="oldAttributeName" value="<%= attr.name %>" />
                              <div class="attribute-row-head">
                                <strong>Edit attribute</strong>
                                <span class="tag neutral"><%= attr.type || 'string' %></span>
                              </div>
                              <div class="field">
                                <label>Attribute name</label>
                                <input name="attributeName" value="<%= attr.name %>" required />
                              </div>
                              <div class="field">
                                <label>Type</label>
                                <select name="attributeType" required>
                                  <option value="string" <%= (attr.type || 'string') === 'string' ? 'selected' : '' %>>string</option>
                                  <option value="email" <%= attr.type === 'email' ? 'selected' : '' %>>email</option>
                                  <option value="number" <%= attr.type === 'number' ? 'selected' : '' %>>number</option>
                                  <option value="boolean" <%= attr.type === 'boolean' ? 'selected' : '' %>>boolean</option>
                                  <option value="array" <%= attr.type === 'array' ? 'selected' : '' %>>array</option>
                                </select>
                              </div>
                              <div class="button-row">
                                <button type="submit">Save attribute</button>
                              </div>
                            </form>
                            <form method="post" action="/admin/service-attributes/remove" class="compact-action" style="margin-top: 10px;">
                              <input type="hidden" name="serviceId" value="<%= s.id %>" />
                              <input type="hidden" name="attributeName" value="<%= attr.name %>" />
                              <button type="submit" class="danger">Remove attribute</button>
                            </form>
                          <% }) %>

                          <form method="post" action="/admin/service-attributes" class="attribute-editor">
                            <input type="hidden" name="serviceId" value="<%= s.id %>" />
                            <div class="field">
                              <label>Attribute name</label>
                              <input name="attributeName" required />
                            </div>
                            <div class="field">
                              <label>Type</label>
                              <select name="attributeType" required>
                                <option value="string">string</option>
                                <option value="email">email</option>
                                <option value="number">number</option>
                                <option value="boolean">boolean</option>
                                <option value="array">array</option>
                              </select>
                            </div>
                            <div class="button-row">
                              <button type="submit" class="secondary">Add attribute</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </article>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </section>

          <section class="panel">
            <h2>Existing Users</h2>
            <p class="panel-intro">Pick a user, then review every service, assignment, and editable claim value from a single workspace.</p>
            <% if (users.length === 0) { %>
              <p class="empty-state">No users are available yet.</p>
            <% } else { %>
              <div class="user-selector-bar">
                <div class="field">
                  <label for="selected-user">Select user</label>
                  <select id="selected-user" name="selectedUserId">
                    <% users.forEach(function(u){ %>
                      <option value="<%= u.id %>" <%= String(u.id) === selectedUserId ? 'selected' : '' %>><%= u.displayName || u.email %> (#<%= u.id %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="tag-list" id="selected-user-meta">
                  <span class="tag neutral" id="selected-user-assignment-count"><%= (assignments[selectedUserId] || []).length %> services</span>
                  <span class="tag neutral" id="selected-user-email"><%= users[0].email %></span>
                </div>
              </div>

              <div class="overview-shell">
                <% users.forEach(function(u){ %>
                  <% var userAssignments = assignments[String(u.id)] || []; %>
                  <div class="user-overview" data-user-overview="<%= u.id %>" <%= String(u.id) === selectedUserId ? '' : 'hidden' %>>
                    <div class="overview-summary">
                      <div>
                        <h3><%= u.displayName || u.email %></h3>
                        <p class="help-text">User #<%= u.id %> · <%= u.email %></p>
                      </div>
                      <div class="tag-list">
                        <span class="tag"><%= userAssignments.length %> assigned services</span>
                        <span class="tag neutral"><%= services.length %> total services</span>
                      </div>
                    </div>

                    <div class="services-list">
                      <% services.forEach(function(s){ %>
                        <% var assigned = userAssignments.indexOf(s.id) !== -1; %>
                        <article class="service-card <%= assigned ? 'assigned' : 'unassigned' %>">
                          <div class="service-head">
                            <div>
                              <h3><%= s.name %></h3>
                              <div class="meta-line">Service #<%= s.id %></div>
                            </div>
                            <div class="service-head-actions">
                              <span class="status-pill <%= assigned ? 'assigned' : 'unassigned' %>"><%= assigned ? 'Assigned' : 'Not assigned' %></span>
                              <% if (assigned) { %>
                                <form method="post" action="/admin/unassign" class="compact-action">
                                  <input type="hidden" name="userId" value="<%= u.id %>" />
                                  <input type="hidden" name="serviceId" value="<%= s.id %>" />
                                  <button type="submit" class="danger">Unassign</button>
                                </form>
                              <% } else { %>
                                <form method="post" action="/admin/assign" class="compact-action">
                                  <input type="hidden" name="userId" value="<%= u.id %>" />
                                  <input type="hidden" name="serviceId" value="<%= s.id %>" />
                                  <button type="submit">Assign</button>
                                </form>
                              <% } %>
                            </div>
                          </div>

                          <div class="service-body">
                            <p class="service-note">
                              <%= (s.attributes && s.attributes.length > 0) ? ('This service exposes ' + s.attributes.length + ' editable attributes.') : 'No service attributes have been defined yet.' %>
                            </p>

                            <% if (assigned && s.attributes && s.attributes.length > 0) { %>
                              <div class="attribute-values">
                                <% s.attributes.forEach(function(attr){ %>
                                  <% var attrKey = u.id + '-' + s.id; %>
                                  <% var attrValue = userAttributesByServiceAndUser[attrKey] && userAttributesByServiceAndUser[attrKey][attr.name] ? userAttributesByServiceAndUser[attrKey][attr.name] : ''; %>
                                  <% var attrValues = attr.type === 'array' ? attrValue.split(/[\n,]/).map(function(value){ return value.trim(); }).filter(Boolean) : [attrValue]; %>
                                  <div class="attribute-row">
                                    <div class="attribute-row-head">
                                      <strong><%= attr.name %></strong>
                                      <span class="tag neutral"><%= attr.type || 'string' %></span>
                                    </div>
                                    <% if (attr.type === 'array') { %>
                                      <div id="attr_group_<%= u.id %>_<%= s.id %>_<%= attr.name %>" data-array-attribute="true" class="array-group">
                                        <% if (attrValues.length > 0) { %>
                                          <% attrValues.forEach(function(value, index){ %>
                                            <div class="array-row">
                                              <input type="text" class="array-attribute-input user-attribute-input" data-array-attribute-input="true" value="<%= value %>" placeholder="Value <%= index + 1 %>" />
                                              <button type="button" class="secondary" onclick="removeAttributeValue(this)">Remove</button>
                                            </div>
                                          <% }) %>
                                        <% } else { %>
                                          <div class="array-row">
                                            <input type="text" class="array-attribute-input user-attribute-input" data-array-attribute-input="true" value="" placeholder="Value 1" />
                                            <button type="button" class="secondary" onclick="removeAttributeValue(this)">Remove</button>
                                          </div>
                                        <% } %>
                                      </div>
                                      <p class="help-text">Add one input per value, then save the attribute set.</p>
                                      <div class="button-row">
                                        <button type="button" class="secondary" data-user-id="<%= u.id %>" data-service-id="<%= s.id %>" data-attr-name="<%= attr.name %>" onclick="addAttributeValue(this)">Add value</button>
                                      </div>
                                    <% } else { %>
                                      <div class="single-input-row">
                                        <input type="text" id="attr_<%= u.id %>_<%= s.id %>_<%= attr.name %>" class="user-attribute-input" value="<%= attrValue %>" />
                                      </div>
                                    <% } %>
                                    <div class="button-row">
                                      <button type="button" data-user-id="<%= u.id %>" data-service-id="<%= s.id %>" data-attr-name="<%= attr.name %>" onclick="setUserAttribute(this)">Save value</button>
                                    </div>
                                  </div>
                                <% }) %>
                              </div>
                            <% } else if (!assigned && s.attributes && s.attributes.length > 0) { %>
                              <p class="service-note">Assign this service to the selected user to edit attribute values.</p>
                            <% } %>
                          </div>
                        </article>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    </div>

    <script>
      function addAttributeValue(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);

        const row = document.createElement('div');
        row.className = 'array-row';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'array-attribute-input user-attribute-input';
        input.setAttribute('data-array-attribute-input', 'true');
        row.appendChild(input);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'secondary';
        removeButton.textContent = 'Remove';
        removeButton.onclick = function () {
          row.remove();
        };
        row.appendChild(removeButton);

        group.appendChild(row);
      }

      function removeAttributeValue(button) {
        const row = button.closest('.array-row');
        if (row) {
          row.remove();
        }
      }

      function setUserAttribute(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);
        const directInputId = 'attr_' + userId + '_' + serviceId + '_' + attributeName;
        const directInput = document.getElementById(directInputId);

        const attributeValues = group
          ? Array.from(group.querySelectorAll('[data-array-attribute-input="true"]'))
              .map(function (input) {
                return input.value.trim();
              })
              .filter(Boolean)
          : [directInput ? directInput.value : ''];

        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/admin/user-attributes';

        const inputs = [
          { name: 'userId', value: userId },
          { name: 'serviceId', value: serviceId },
          { name: 'attributeName', value: attributeName },
        ];

        if (group) {
          attributeValues.forEach(function (value) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = value;
            form.appendChild(field);
          });
          if (!attributeValues.length) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = '';
            form.appendChild(field);
          }
        } else {
          inputs.push({ name: 'attributeValue', value: attributeValues[0] });
        }

        inputs.forEach(function (input) {
          const field = document.createElement('input');
          field.type = 'hidden';
          field.name = input.name;
          field.value = input.value;
          form.appendChild(field);
        });

        document.body.appendChild(form);
        form.submit();
      }

      function updateSelectedUserOverview(userId) {
        const panels = document.querySelectorAll('[data-user-overview]');
        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-user-overview') !== userId;
        });

        const userOption = document.querySelector('#selected-user option[value="' + CSS.escape(userId) + '"]');
        const assignmentCount = document.getElementById('selected-user-assignment-count');
        const selectedUserEmail = document.getElementById('selected-user-email');
        if (assignmentCount || selectedUserEmail) {
          const activePanel = document.querySelector('[data-user-overview="' + CSS.escape(userId) + '"]');
          const activeName = userOption ? userOption.textContent : 'Selected user';
          const activeAssignmentCount = activePanel ? activePanel.querySelectorAll('.service-card.assigned').length : 0;
          if (assignmentCount) {
            assignmentCount.textContent = activeAssignmentCount + ' services';
          }
          if (selectedUserEmail) {
            selectedUserEmail.textContent = activeName;
          }
        }
      }

      const selectedUserSelect = document.getElementById('selected-user');
      if (selectedUserSelect) {
        selectedUserSelect.addEventListener('change', function (event) {
          updateSelectedUserOverview(String(event.target.value));
        });
        updateSelectedUserOverview(String(selectedUserSelect.value));
      }

      function updateSelectedServiceOverview(serviceId) {
        const panels = document.querySelectorAll('[data-service-overview]');
        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-service-overview') !== serviceId;
        });

        const serviceOption = document.querySelector('#selected-service option[value="' + serviceId + '"]');
        const attributeCount = document.getElementById('selected-service-attribute-count');
        const selectedServiceName = document.getElementById('selected-service-name');
        const activePanel = document.querySelector('[data-service-overview="' + serviceId + '"]');
        if (attributeCount) {
          const activeCount = activePanel ? Number(activePanel.getAttribute('data-attribute-count') || '0') : 0;
          attributeCount.textContent = activeCount + ' attributes';
        }
        if (selectedServiceName && serviceOption) {
          selectedServiceName.textContent = serviceOption.textContent;
        }
      }

      const selectedServiceSelect = document.getElementById('selected-service');
      if (selectedServiceSelect) {
        selectedServiceSelect.addEventListener('change', function (event) {
          updateSelectedServiceOverview(String(event.target.value));
        });
        updateSelectedServiceOverview(String(selectedServiceSelect.value));
      }
    </script>
  </body>
</html>
