<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles/main.css" />
  </head>
  <body>
    <% const serviceCount = services.length; %>
    <% const userCount = users.length; %>
    <% const assignmentCount = Object.values(assignments).reduce(function(total, ids){ return total + ids.length; }, 0); %>
    <% const activeUserId = typeof selectedUserId !== 'undefined' && selectedUserId ? String(selectedUserId) : (users.length ? String(users[0].id) : ''); %>
    <% const activeServiceId = typeof selectedServiceId !== 'undefined' && selectedServiceId ? String(selectedServiceId) : (services.length ? String(services[0].id) : ''); %>

    <div class="page">
      <header class="hero">
        <span class="eyebrow">Admin console</span>
        <h1>Control identity with a calmer, sharper dashboard.</h1>
        <p class="hero-copy">Create users, manage service metadata, and assign attributes.</p>
        <div class="hero-meta">
          <span class="chip"><strong><%= userCount %></strong> users</span>
          <span class="chip"><strong><%= serviceCount %></strong> services</span>
          <span class="chip"><strong><%= assignmentCount %></strong> assignments</span>
        </div>
      </header>

      <div class="layout">
        <div class="stack">
          <section class="panel">
            <h2>Create User</h2>
            <p class="panel-intro">Spin up a new account for direct login or SAML-linked access.</p>
            <form method="post" action="/admin/users" class="form-grid">
              <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
              <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
              <div class="field">
                <label for="user-email">Email</label>
                <input id="user-email" name="email" type="email" required />
              </div>
              <div class="field">
                <label for="user-display-name">Display name</label>
                <input id="user-display-name" name="displayName" />
              </div>
              <div class="field">
                <label for="user-password">Password</label>
                <input id="user-password" name="password" type="password" required />
              </div>
              <div class="button-row">
                <button type="submit">Create user</button>
              </div>
            </form>
          </section>

          <section class="panel">
            <h2>Create Service</h2>
            <p class="panel-intro">Register a service provider entry and describe the target audience.</p>
            <form method="post" action="/admin/services" class="form-grid">
              <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
              <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
              <div class="field">
                <label for="service-name">Service URL or name</label>
                <input id="service-name" name="name" required />
              </div>
              <div class="field">
                <label for="service-description">Description</label>
                <textarea id="service-description" name="description" placeholder="Optional context for this service"></textarea>
              </div>
              <div class="button-row">
                <button type="submit">Create service</button>
              </div>
            </form>
          </section>
        </div>

        <div class="stack">
          <section class="panel">
            <h2>Service Attributes</h2>
            <p class="panel-intro">Choose a service, then edit its attributes and definition.</p>
            <% if (services.length === 0) { %>
              <p class="empty-state">No services are configured yet.</p>
            <% } else { %>
              <div class="service-workbench">
                <div class="service-selector-bar">
                  <div class="field">
                    <label for="selected-service">Select service</label>
                    <select id="selected-service" name="selectedServiceId">
                      <% services.forEach(function(s){ %>
                        <option value="<%= s.id %>" <%= String(s.id) === selectedServiceId ? 'selected' : '' %>><%= s.name %> (#<%= s.id %>)</option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="tag-list" id="selected-service-meta">
                    <span class="tag neutral" id="selected-service-attribute-count"><%= (services[0].attributes || []).length %> attributes</span>
                    <span class="tag neutral" id="selected-service-name"><%= services[0].name %></span>
                  </div>
                </div>

                <div class="service-list-grid">
                  <% services.forEach(function(s){ %>
                    <article class="service-overview" data-service-overview="<%= s.id %>" data-attribute-count="<%= (s.attributes || []).length %>" <%= String(s.id) === selectedServiceId ? '' : 'hidden' %>>
                      <div class="service-summary">
                        <div>
                          <h3><%= s.name %></h3>
                          <p class="help-text">Service #<%= s.id %></p>
                        </div>
                        <div class="tag-list">
                          <span class="tag"><%= (s.attributes || []).length %> attributes</span>
                        </div>
                      </div>

                      <div class="service-card assigned">
                        <div class="service-body">
                          <p class="service-note">
                            <%= (s.attributes && s.attributes.length > 0) ? ('This service exposes ' + s.attributes.length + ' editable attributes.') : 'No service attributes have been defined yet.' %>
                          </p>

                          <% (s.attributes || []).forEach(function(attr){ %>
                            <form method="post" action="/admin/service-attributes/update" class="attribute-editor">
                              <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
                              <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
                              <input type="hidden" name="serviceId" value="<%= s.id %>" />
                              <input type="hidden" name="oldAttributeName" value="<%= attr.name %>" />
                              <div class="attribute-row-head">
                                <strong>Edit attribute</strong>
                                <span class="tag neutral"><%= attr.type || 'string' %></span>
                              </div>
                              <div class="field">
                                <label>Attribute name</label>
                                <input name="attributeName" value="<%= attr.name %>" required />
                              </div>
                              <div class="field">
                                <label>Type</label>
                                <select name="attributeType" required>
                                  <option value="string" <%= (attr.type || 'string') === 'string' ? 'selected' : '' %>>string</option>
                                  <option value="email" <%= attr.type === 'email' ? 'selected' : '' %>>email</option>
                                  <option value="number" <%= attr.type === 'number' ? 'selected' : '' %>>number</option>
                                  <option value="boolean" <%= attr.type === 'boolean' ? 'selected' : '' %>>boolean</option>
                                  <option value="array" <%= attr.type === 'array' ? 'selected' : '' %>>array</option>
                                </select>
                              </div>
                              <div class="button-row">
                                <button type="submit">Save attribute</button>
                              </div>
                            </form>
                            <form method="post" action="/admin/service-attributes/remove" class="compact-action" style="margin-top: 10px;">
                              <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
                              <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
                              <input type="hidden" name="serviceId" value="<%= s.id %>" />
                              <input type="hidden" name="attributeName" value="<%= attr.name %>" />
                              <button type="submit" class="danger">Remove attribute</button>
                            </form>
                          <% }) %>

                          <form method="post" action="/admin/service-attributes" class="attribute-editor">
                            <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
                            <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
                            <input type="hidden" name="serviceId" value="<%= s.id %>" />
                            <div class="field">
                              <label>Attribute name</label>
                              <input name="attributeName" required />
                            </div>
                            <div class="field">
                              <label>Type</label>
                              <select name="attributeType" required>
                                <option value="string">string</option>
                                <option value="email">email</option>
                                <option value="number">number</option>
                                <option value="boolean">boolean</option>
                                <option value="array">array</option>
                              </select>
                            </div>
                            <div class="button-row">
                              <button type="submit" class="secondary">Add attribute</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </article>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </section>

          <section class="panel">
            <h2>Existing Users</h2>
            <p class="panel-intro">Pick a user, then review every service, assignment, and editable attribute value.</p>
            <% if (users.length === 0) { %>
              <p class="empty-state">No users are available yet.</p>
            <% } else { %>
              <div class="user-selector-bar">
                <div class="field">
                  <label for="selected-user">Select user</label>
                  <select id="selected-user" name="selectedUserId">
                    <% users.forEach(function(u){ %>
                      <option value="<%= u.id %>" <%= String(u.id) === activeUserId ? 'selected' : '' %>><%= u.displayName || u.email %> (#<%= u.id %>)</option>
                    <% }) %>
                  </select>
                </div>
                <div class="tag-list" id="selected-user-meta">
                  <span class="tag neutral" id="selected-user-assignment-count"><%= (assignments[activeUserId] || []).length %> services</span>
                  <span class="tag neutral" id="selected-user-email"><%= users[0].email %></span>
                </div>
              </div>

              <div class="overview-shell">
                <% users.forEach(function(u){ %>
                  <% var userAssignments = assignments[String(u.id)] || []; %>
                  <div class="user-overview" data-user-overview="<%= u.id %>" <%= String(u.id) === activeUserId ? '' : 'hidden' %>>
                    <div class="overview-summary">
                      <div>
                        <h3><%= u.displayName || u.email %></h3>
                        <p class="help-text">User #<%= u.id %> · <%= u.email %></p>
                      </div>
                      <div class="tag-list">
                        <span class="tag"><%= userAssignments.length %> assigned services</span>
                        <span class="tag neutral"><%= services.length %> total services</span>
                      </div>
                    </div>

                    <div class="services-list">
                      <% services.forEach(function(s){ %>
                        <% var assigned = userAssignments.indexOf(s.id) !== -1; %>
                        <article class="service-card <%= assigned ? 'assigned' : 'unassigned' %>">
                          <div class="service-head">
                            <div>
                              <h3><%= s.name %></h3>
                              <div class="meta-line">Service #<%= s.id %></div>
                            </div>
                            <div class="service-head-actions">
                              <span class="status-pill <%= assigned ? 'assigned' : 'unassigned' %>"><%= assigned ? 'Assigned' : 'Not assigned' %></span>
                              <% if (assigned) { %>
                                <form method="post" action="/admin/unassign" class="compact-action">
                                  <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
                                  <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
                                  <input type="hidden" name="userId" value="<%= u.id %>" />
                                  <input type="hidden" name="serviceId" value="<%= s.id %>" />
                                  <button type="submit" class="danger">Unassign</button>
                                </form>
                              <% } else { %>
                                <form method="post" action="/admin/assign" class="compact-action">
                                  <input type="hidden" name="selectedUserId" value="<%= activeUserId %>" data-selected-user-id-field />
                                  <input type="hidden" name="selectedServiceId" value="<%= activeServiceId %>" data-selected-service-id-field />
                                  <input type="hidden" name="userId" value="<%= u.id %>" />
                                  <input type="hidden" name="serviceId" value="<%= s.id %>" />
                                  <button type="submit">Assign</button>
                                </form>
                              <% } %>
                            </div>
                          </div>

                          <div class="service-body">
                            <p class="service-note">
                              <%= (s.attributes && s.attributes.length > 0) ? ('This service exposes ' + s.attributes.length + ' editable attributes.') : 'No service attributes have been defined yet.' %>
                            </p>

                            <% if (assigned && s.attributes && s.attributes.length > 0) { %>
                              <div class="attribute-values">
                                <% s.attributes.forEach(function(attr){ %>
                                  <% var attrKey = u.id + '-' + s.id; %>
                                  <% var attrValue = userAttributesByServiceAndUser[attrKey] && userAttributesByServiceAndUser[attrKey][attr.name] ? userAttributesByServiceAndUser[attrKey][attr.name] : ''; %>
                                  <% var attrValues = attr.type === 'array' ? attrValue.split(/[\n,]/).map(function(value){ return value.trim(); }).filter(Boolean) : [attrValue]; %>
                                  <div class="attribute-row">
                                    <div class="attribute-row-head">
                                      <strong><%= attr.name %></strong>
                                      <span class="tag neutral"><%= attr.type || 'string' %></span>
                                    </div>
                                    <% if (attr.type === 'array') { %>
                                      <div id="attr_group_<%= u.id %>_<%= s.id %>_<%= attr.name %>" data-array-attribute="true" class="array-group">
                                        <% if (attrValues.length > 0) { %>
                                          <% attrValues.forEach(function(value, index){ %>
                                            <div class="array-row">
                                              <input type="text" class="array-attribute-input user-attribute-input" data-array-attribute-input="true" value="<%= value %>" placeholder="Value <%= index + 1 %>" />
                                              <button type="button" class="secondary" onclick="removeAttributeValue(this)">Remove</button>
                                            </div>
                                          <% }) %>
                                        <% } else { %>
                                          <div class="array-row">
                                            <input type="text" class="array-attribute-input user-attribute-input" data-array-attribute-input="true" value="" placeholder="Value 1" />
                                            <button type="button" class="secondary" onclick="removeAttributeValue(this)">Remove</button>
                                          </div>
                                        <% } %>
                                      </div>
                                      <p class="help-text">Add one input per value, then save the attribute set.</p>
                                      <div class="button-row">
                                        <button type="button" class="secondary" data-user-id="<%= u.id %>" data-service-id="<%= s.id %>" data-attr-name="<%= attr.name %>" onclick="addAttributeValue(this)">Add value</button>
                                      </div>
                                    <% } else { %>
                                      <div class="single-input-row">
                                        <input type="text" id="attr_<%= u.id %>_<%= s.id %>_<%= attr.name %>" class="user-attribute-input" value="<%= attrValue %>" />
                                      </div>
                                    <% } %>
                                    <div class="button-row">
                                      <button type="button" data-user-id="<%= u.id %>" data-service-id="<%= s.id %>" data-attr-name="<%= attr.name %>" onclick="setUserAttribute(this)">Save value</button>
                                    </div>
                                  </div>
                                <% }) %>
                              </div>
                            <% } else if (!assigned && s.attributes && s.attributes.length > 0) { %>
                              <p class="service-note">Assign this service to the selected user to edit attribute values.</p>
                            <% } %>
                          </div>
                        </article>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </section>
        </div>
      </div>
    </div>

    <script>
      function addAttributeValue(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);

        const row = document.createElement('div');
        row.className = 'array-row';

        const input = document.createElement('input');
        input.type = 'text';
        input.className = 'array-attribute-input user-attribute-input';
        input.setAttribute('data-array-attribute-input', 'true');
        row.appendChild(input);

        const removeButton = document.createElement('button');
        removeButton.type = 'button';
        removeButton.className = 'secondary';
        removeButton.textContent = 'Remove';
        removeButton.onclick = function () {
          row.remove();
        };
        row.appendChild(removeButton);

        group.appendChild(row);
      }

      function removeAttributeValue(button) {
        const row = button.closest('.array-row');
        if (row) {
          row.remove();
        }
      }

      function setUserAttribute(button) {
        const userId = button.getAttribute('data-user-id');
        const serviceId = button.getAttribute('data-service-id');
        const attributeName = button.getAttribute('data-attr-name');
        const groupId = 'attr_group_' + userId + '_' + serviceId + '_' + attributeName;
        const group = document.getElementById(groupId);
        const directInputId = 'attr_' + userId + '_' + serviceId + '_' + attributeName;
        const directInput = document.getElementById(directInputId);

        const attributeValues = group
          ? Array.from(group.querySelectorAll('[data-array-attribute-input="true"]'))
              .map(function (input) {
                return input.value.trim();
              })
              .filter(Boolean)
          : [directInput ? directInput.value : ''];

        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/admin/user-attributes';

        const inputs = [
          { name: 'userId', value: userId },
          { name: 'serviceId', value: serviceId },
          { name: 'attributeName', value: attributeName },
        ];

        if (group) {
          attributeValues.forEach(function (value) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = value;
            form.appendChild(field);
          });
          if (!attributeValues.length) {
            const field = document.createElement('input');
            field.type = 'hidden';
            field.name = 'attributeValue[]';
            field.value = '';
            form.appendChild(field);
          }
        } else {
          inputs.push({ name: 'attributeValue', value: attributeValues[0] });
        }

        inputs.forEach(function (input) {
          const field = document.createElement('input');
          field.type = 'hidden';
          field.name = input.name;
          field.value = input.value;
          form.appendChild(field);
        });

        document.body.appendChild(form);
        form.submit();
      }

      function syncSelectionFields(userId, serviceId) {
        document.querySelectorAll('[data-selected-user-id-field]').forEach(function(field) {
          field.value = userId;
        });

        document.querySelectorAll('[data-selected-service-id-field]').forEach(function(field) {
          field.value = serviceId;
        });
      }

      function updateSelectedUserOverview(userId) {
        const panels = document.querySelectorAll('[data-user-overview]');
        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-user-overview') !== userId;
        });

        const userOption = document.querySelector('#selected-user option[value="' + CSS.escape(userId) + '"]');
        const assignmentCount = document.getElementById('selected-user-assignment-count');
        const selectedUserEmail = document.getElementById('selected-user-email');
        if (assignmentCount || selectedUserEmail) {
          const activePanel = document.querySelector('[data-user-overview="' + CSS.escape(userId) + '"]');
          const activeName = userOption ? userOption.textContent : 'Selected user';
          const activeAssignmentCount = activePanel ? activePanel.querySelectorAll('.service-card.assigned').length : 0;
          if (assignmentCount) {
            assignmentCount.textContent = activeAssignmentCount + ' services';
          }
          if (selectedUserEmail) {
            selectedUserEmail.textContent = activeName;
          }
        }

        const serviceSelect = document.getElementById('selected-service');
        const currentServiceId = serviceSelect ? String(serviceSelect.value) : '';
        syncSelectionFields(userId, currentServiceId);
      }

      const selectedUserSelect = document.getElementById('selected-user');
      if (selectedUserSelect) {
        selectedUserSelect.addEventListener('change', function (event) {
          updateSelectedUserOverview(String(event.target.value));
        });
      }

      function updateSelectedServiceOverview(serviceId) {
        const panels = document.querySelectorAll('[data-service-overview]');
        panels.forEach(function(panel) {
          panel.hidden = panel.getAttribute('data-service-overview') !== serviceId;
        });

        const serviceOption = document.querySelector('#selected-service option[value="' + serviceId + '"]');
        const attributeCount = document.getElementById('selected-service-attribute-count');
        const selectedServiceName = document.getElementById('selected-service-name');
        const activePanel = document.querySelector('[data-service-overview="' + serviceId + '"]');
        if (attributeCount) {
          const activeCount = activePanel ? Number(activePanel.getAttribute('data-attribute-count') || '0') : 0;
          attributeCount.textContent = activeCount + ' attributes';
        }
        if (selectedServiceName && serviceOption) {
          selectedServiceName.textContent = serviceOption.textContent;
        }

        const userSelect = document.getElementById('selected-user');
        const currentUserId = userSelect ? String(userSelect.value) : '';
        syncSelectionFields(currentUserId, serviceId);
      }

      const selectedServiceSelect = document.getElementById('selected-service');
      if (selectedServiceSelect) {
        selectedServiceSelect.addEventListener('change', function (event) {
          updateSelectedServiceOverview(String(event.target.value));
        });
      }

      if (selectedUserSelect && selectedServiceSelect) {
        syncSelectionFields(String(selectedUserSelect.value), String(selectedServiceSelect.value));
        updateSelectedUserOverview(String(selectedUserSelect.value));
        updateSelectedServiceOverview(String(selectedServiceSelect.value));
      }
    </script>
  </body>
</html>
