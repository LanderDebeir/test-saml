<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || 'Admin Login' %></title>
    <link rel="stylesheet" href="/styles/login.css" />
  </head>
  <body>
    <main class="shell">
      <section class="intro">
        <div>
          <span class="eyebrow">Admin access</span>
          <h1><%= heading || 'Admin Login' %></h1>
        </div>
        <div class="intro-note">
          <strong>Secure entry point</strong>
          <p>
            Use your admin credentials to manage users, services, and SAML attribute mappings.
          </p>
        </div>
      </section>

      <section class="form-pane">
        <h2>Welcome back</h2>
        <p class="subcopy">Sign in to continue to the administration console.</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="error"><%= error %></div>
        <% } %>

        <% if (typeof samlMode !== 'undefined' && samlMode) { %>
        <div class="notice">
          You are signing in to continue to <strong><%= issuer %></strong>.
          The service provider ACS URL is <code><%= assertionConsumerServiceUrl %></code>.
        </div>
        <% } %>

        <form method="post" action="<%= formAction || '/admin/login' %>" class="form-grid">
          <input type="hidden" name="SAMLRequest" value="<%= typeof SAMLRequest !== 'undefined' ? SAMLRequest : '' %>" />
          <% if (typeof RelayState !== 'undefined' && RelayState) { %>
          <input type="hidden" name="RelayState" value="<%= RelayState %>" />
          <% } %>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" required />
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input id="password" type="password" name="password" required />
          </div>
          <div class="button-row">
            <button type="submit"><%= buttonLabel || 'Login' %></button>
          </div>
        </form>

        <% if (typeof samlMode !== 'undefined' && samlMode) { %>
        <form method="get" action="/admin" class="button-row">
          <button type="submit" class="secondary">Go to admin dashboard</button>
        </form>
        <% } %>
      </section>
    </main>
  </body>
</html>
